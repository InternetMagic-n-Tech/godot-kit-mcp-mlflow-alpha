# Temperature 0.1 set repeat_penalty, top_p & min_p for programming
FROM ${COMPARE_MODEL_ALT_1}
PARAMETER temperature 0.1
PARAMETER top_p 0.90
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.05
