# Temperature 0.2 set repeat_penalty, top_p & min_p for code exploration + collaborative debugging
FROM ${COMPARE_MODEL_ALT_2}
PARAMETER temperature 0.55
PARAMETER top_p 0.85
PARAMETER top_k 20
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.10

TEMPLATE """
${TOOL_UPDATE}
"""

SYSTEM """
[COLLAB-CODER.md](system-prompts/COLLAB-CODER.md)
"""
