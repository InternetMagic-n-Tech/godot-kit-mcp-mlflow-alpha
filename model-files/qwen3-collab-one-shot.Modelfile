# Temperature 0.2 set repeat_penalty, top_p & min_p for code exploration + collaborative debugging
FROM ${COMPARE_MODEL}
PARAMETER temperature 0.65
PARAMETER top_p 0.85
PARAMETER top_k 20
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.05

SYSTEM """
[system-prompts/ONE-SHOT-CODER.md](system-prompts/ONE-SHOT-CODER.md)
"""
