--- /dev/null	2026-10-25 05:49:11.866000179 -0400
+++ mlflow/docker-compose/.env	2026-10-25 21:36:10.382891951 -0400
@@ -0,0 +1,29 @@
+# PostgreSQL
+POSTGRES_USER=mlflow
+POSTGRES_PASSWORD=mlflow
+POSTGRES_DB=mlflow
+PGPORT=5432
+
+# --- RustFS (S3-compatible artifact storage) ---
+AWS_ACCESS_KEY_ID=s3admin
+AWS_SECRET_ACCESS_KEY=s3admin
+AWS_DEFAULT_REGION=us-east-1
+RUSTFS_CONSOLE_ENABLE=true
+S3_BUCKET=mlflow
+MLFLOW_S3_ENDPOINT_URL=http://storage:9000
+MLFLOW_ARTIFACTS_DESTINATION=s3://${S3_BUCKET}
+
+# --- MLflow server ---
+MLFLOW_VERSION=v3.16.1
+MLFLOW_HOST=0.0.0.0
+MLFLOW_PORT=5000
+MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${PGPORT}/${POSTGRES_DB}
+
+MLFLOW_AUTH_DISABLE=true
+MLFLOW_ENABLE_REMOTE_ASSISTANT=true
+
+OLLAMA_MODEL=gemma4:26b
+OLLAMA_HOST="http://host.docker.internal:11434"
+OPENAI_API_BASE="http://host.docker.internal:11434/v1"
+OPENAI_API_KEY=none
+GODOT_PROJECT_DIR=/home/orangelegend/Labs/godot-kit-mcp-loop
